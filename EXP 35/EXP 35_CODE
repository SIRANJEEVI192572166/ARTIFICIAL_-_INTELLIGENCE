from sklearn.tree import DecisionTreeClassifier

X = [[1, 20], [2, 25], [3, 30],
     [6, 60], [7, 65], [8, 70]]

y = ['Low', 'Low', 'Low',
     'High', 'High', 'High']

model = DecisionTreeClassifier(random_state=0)
model.fit(X, y)

prediction = model.predict([[7, 60]])

print("Decision Tree Classification")
print("Predicted Class:", prediction[0])
