from collections import deque

# State = (missionaries_left, cannibals_left, boat_position)

start = (3, 3, 0)
goal = (0, 0, 1)

moves = [(1, 0), (2, 0), (0, 1),
         (0, 2), (1, 1)]

def valid(m, c):
    mr = 3 - m
    cr = 3 - c

    if m < 0 or c < 0 or m > 3 or c > 3:
        return False

    if m > 0 and m < c:
        return False

    if mr > 0 and mr < cr:
        return False

    return True

queue = deque([(start, [])])
visited = {start}

while queue:
    state, path = queue.popleft()
    m, c, boat = state

    if state == goal:
        print("Solution:")
        for s in path + [state]:
            print(s)
        break

    for dm, dc in moves:
        if boat == 0:
            new_state = (m - dm, c - dc, 1)
        else:
            new_state = (m + dm, c + dc, 0)

        if new_state not in visited and valid(new_state[0],
                                              new_state[1]):
            visited.add(new_state)
            queue.append((new_state, path + [state]))
