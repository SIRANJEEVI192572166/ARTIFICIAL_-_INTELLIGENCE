import numpy as np
import random

random.seed(1)
np.random.seed(1)

X = np.array([
    [0, 0], [0, 1], [1, 0], [1, 1]
])

y = np.array([[0], [1], [1], [0]])

def sigmoid(x):
    return 1 / (1 + np.exp(-x))

def fitness(weights):
    w1 = weights[:4].reshape(2, 2)
    w2 = weights[4:].reshape(2, 1)

    hidden = sigmoid(X @ w1)
    output = sigmoid(hidden @ w2)

    error = np.mean((y - output) ** 2)

    return 1 / (1 + error)

population = [
    np.random.uniform(-2, 2, 6) for _ in range(20)
]

for generation in range(100):
    population.sort(key=fitness, reverse=True)

    new_population = population[:2]

    while len(new_population) < 20:
        p1, p2 = random.choices(population[:10], k=2)

        child = (p1 + p2) / 2
        child += np.random.normal(0, 0.1, 6)

        new_population.append(child)

    population = new_population

best = max(population, key=fitness)

print("Genetic Algorithm Neural Network")
print("Best Fitness:", round(fitness(best), 4))
print("Evolution Completed")
