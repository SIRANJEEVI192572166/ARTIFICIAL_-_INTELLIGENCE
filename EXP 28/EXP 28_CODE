% Medical Diagnosis System

symptom(ravi, fever).
symptom(ravi, cough).

symptom(anu, headache).
symptom(anu, fever).

diagnosis(Patient, flu) :-
    symptom(Patient, fever),
    symptom(Patient, cough).

diagnosis(Patient, possible_fever) :-
    symptom(Patient, fever).

diagnosis(Patient, possible_headache) :-
    symptom(Patient, headache).
