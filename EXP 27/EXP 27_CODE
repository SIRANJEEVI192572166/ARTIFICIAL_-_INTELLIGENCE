% Best First Search

edge(a, b, 2).
edge(a, c, 4).
edge(b, d, 3).
edge(b, e, 5).
edge(c, f, 2).
edge(d, g, 4).
edge(e, g, 1).
edge(f, g, 3).

heuristic(a, 6).
heuristic(b, 4).
heuristic(c, 3).
heuristic(d, 3).
heuristic(e, 1).
heuristic(f, 2).
heuristic(g, 0).

best_first(Start, Goal) :-
    search([Start], Goal, []).

search([Goal|_], Goal, _) :-
    write('Goal found: '),
    write(Goal),
    nl.

search([Current|Rest], Goal, Visited) :-
    findall(H-Next,
        (edge(Current, Next, _),
         \+ member(Next, Visited),
         heuristic(Next, H)),
        Children),
    keysort(Children, Sorted),
    pairs_values(Sorted, NextNodes),
    append(NextNodes, Rest, NewOpen),
    search(NewOpen, Goal, [Current|Visited]).
